        {"target": "shaft", "do": "highlight", "at": "a shaft", "params": {"hold": true, "strength": 1.5}, "sfx": "click"},
        {"target": ["c1", "c2", "c3", "c4"], "do": "highlight", "at": "compressor", "params": {"hold": true}},
        {"target": "fan", "do": "highlight", "at": "and the fan", "params": {"hold": true}}
