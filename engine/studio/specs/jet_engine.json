        {"target": "core_case", "do": "highlight", "at": "core", "params": {"strength": 0.5}}
      ],
      "shots": [
        {"type": "orbit", "target": "nacelle", "frame": ["nacelle"], "azimuth": -30, "elevation": 22, "orbit": 30, "lens": 50}
      ]
    },
