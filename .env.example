# ── Viral Reels Studio ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All fields have sensible defaults; override only what you need.

# ── Directories ─────────────────────────────────────────────────────
OUTPUT_DIR=export
TEMP_DIR=tmp
RAW_FOOTAGE_DIR=raw-footage

# ── FFmpeg ──────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg

# ── Whisper (speech-to-text) ────────────────────────────────────────
# Models: tiny, base, small, medium, large
WHISPER_MODEL=base

# ── Edge TTS (text-to-speech) ───────────────────────────────────────
EDGE_TTS_VOICE=en-US-ChristopherNeural

# ── Video output ────────────────────────────────────────────────────
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
FPS=30

# ── Captions ────────────────────────────────────────────────────────
# Styles: bold_pop, minimal
CAPTION_STYLE=bold_pop

# ── Instagram Authentication ─────────────────────────────────────────
# OPTION A: Browser Session ID (FASTEST & EASIEST - 100% bypasses app version checks)
# Copy 'sessionid' cookie from Chrome/Safari developer tools on instagram.com
INSTAGRAM_SESSIONID=

# OPTION B: Direct Mobile Login (Username + Password)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# OPTION B: Meta Graph API (Optional, if using Facebook Developer App)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
