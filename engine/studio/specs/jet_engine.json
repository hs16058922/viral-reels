  "scenes": [
    {
      "id": "hook",
      "narration": "A jet engine is basically a giant fan, spinning inside a controlled explosion.",
      "objective": "Hook: fan spins up, then the cutaway reveals fire inside",
      "background": "blue",
      "keywords": ["giant fan", "controlled explosion"],
      "use": ["rig", "shell", "rotors", "flame"],
      "objects": [],
      "actions": [
        {"target": ["fan", "c1", "s1", "c2", "s2", "c3", "s3", "c4", "t1", "t2"], "do": "spin", "params": {"rate": 150, "ramp": 1.2}},
        {"target": "flame", "do": "hide", "at": 0},
        {"target": "flame", "do": "show", "at": "explosion", "sfx": "impact"},
        {"target": "flame", "do": "pulse", "at": "explosion", "params": {"amount": 0.05, "hz": 4}},
        {"target": "fan", "do": "highlight", "at": "giant fan", "params": {"color": "#FFFFFF", "strength": 0.6}}
      ],
      "shots": [
        {"type": "push_in", "target": "fan", "frame": ["nacelle"], "azimuth": 62, "elevation": 14, "lens": 50},
        {"at": "controlled explosion", "offset": -0.4, "type": "orbit", "target": "core_case", "frame": ["nacelle"], "azimuth": -28, "elevation": 22, "orbit": 20, "lens": 50}
      ]
    },
    {
      "id": "bypass",
      "narration": "The big fan at the front pulls in air. Most of it flows around the core, and that bypass air makes most of the thrust.",
      "objective": "Airflow split: bypass stream around the core vs. core stream",
      "background": "light",
      "keywords": ["pulls in air", "bypass air"],
      "use": ["rig", "shell", "rotors", "air"],
      "objects": [],
      "actions": [
        {"target": ["fan", "c1", "c2", "c3", "c4", "t1", "t2"], "do": "spin", "params": {"rate": 150, "ramp": 0}},
